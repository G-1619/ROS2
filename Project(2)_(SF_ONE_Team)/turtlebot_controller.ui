     <property name="styleSheet">
      <string notr="true">QPushButton {
    /* 이미지를 배경으로 설정 */
    border-image: url(:/newPrefix/Button.png); 
    /* 또는 배경 이미지가 반복되지 않게 하려면 */
    /* background-image: url(&quot;C:/path/to/your/image.png&quot;); */
    /* background-repeat: no-repeat; */
    /* background-position: center; */
    
    border: none;       /* 기본 테두리 제거 */
    background: none;   /* 기본 회색 배경 제거 */
}

QPushButton:pressed {
    /* 검은색(0,0,0)에 투명도 80(약 30%)을 줘서 어둡게 만듭니다. */
    background-color: rgba(0, 0, 0, 80); 
    
    /* 선택 사항: 이미지가 아주 살짝 아래로 눌리는 느낌 추가 */
    padding-top: 2px;
    padding-left: 2px;
}</string>
